PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/neuroai
CORS_ORIGIN=http://localhost:3000
OLLAMA_URL=http://100.86.196.111:11434/api/generate
OLLAMA_MODEL=llama3.2:latest

# --- auth ---
# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=7d

# --- seed data ---
# true (default): on every start, create any missing demo data. Never overwrites existing data.
AUTO_SEED=true
# password given to the demo accounts the first time they are created
SEED_PASSWORD=password123
